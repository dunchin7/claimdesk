# --- OpenAI ----------------------------------------------------------------
# One key powers chat + embeddings. Set OPENAI_BASE_URL to use any
# OpenAI-compatible endpoint (a gateway, a local server, etc.); leave blank
# for the default https://api.openai.com/v1.
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Cheap tier — extraction, vision, email prose.
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# text-embedding-3-small = 1536; ada-002 = 1536; 3-large = 3072.
# Drives the pgvector column dimension (see migrations).
EMBEDDING_DIM=1536

# Frontier tier (optional) — routes the `reasoner` + `judge` aliases (the hard
# reasoning: adjudication + citation verification) to a stronger model. Blank =
# falls back to OPENAI_CHAT_MODEL (single-model default). The key/base let the
# reasoner use a different provider entirely; blank = reuse OPENAI_API_KEY/BASE.
OPENAI_REASONER_MODEL=
OPENAI_REASONER_API_KEY=
OPENAI_REASONER_BASE_URL=

# --- Database --------------------------------------------------------------
# Async URL used by the FastAPI app (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://dev:dev@localhost:5432/claims_copilot
# Sync URL used by Alembic migrations (psycopg driver).
ALEMBIC_DATABASE_URL=postgresql+psycopg://dev:dev@localhost:5432/claims_copilot

# --- App -------------------------------------------------------------------
APP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=false

# --- Observability (optional; no-ops when blank) --------------------------
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
SENTRY_DSN=

# --- Integrations (optional; leave blank to run the synthetic pipeline) ---
COHERE_API_KEY=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_STORE_DOMAIN=

# --- Safety override -------------------------------------------------------
# When true, every claim is routed to human review regardless of confidence.
# Recommended until the calibrator is trained/validated on real, labeled
# claims. Leave false for the synthetic demo/eval.
DISABLE_AUTO_RESOLVE=false
